# =============================================================================
# 2nd Wave Laundry — proposed .env.example (handover draft, 2026-11-13)
#
# PLACEHOLDERS ONLY. Never commit real values. Copy to .env.local for local work.
# Source of truth for each variable: docs/handover/analysis/02-env-services-emails.md §1
#
# Safe local default: leave everything below as-is (demo mode on, no database,
# no email). Only fill the Supabase/Brevo blocks for a NON-production project.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Demo mode is ON unless this is exactly "false". Production must be "false".
NEXT_PUBLIC_DEMO_MODE=true
# Public canonical origin. Any value other than https://www.2ndwavelaundry.com is ignored by src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.2ndwavelaundry.com
# Server-only origin used for EVERY link inside emails and for request-origin checks. https origin, no path (http allowed only for localhost).
SITE_URL=http://localhost:3000
# Optional search-engine verification tokens rendered into page metadata.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Emergency kill switch: "true" makes all CMS writes return 503.
WEBSITE_CONTENT_WRITES_DISABLED=

# -----------------------------------------------------------------------------
# Supabase  (Dashboard → Project Settings → API)
# -----------------------------------------------------------------------------
# Project URL. Must be https:// (a local http://127.0.0.1 stack is rejected by src/lib/supabase/config.ts).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (browser-safe) key, sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for the publishable key (anon JWT). Leave empty if the publishable key is set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret key, sb_secret_... Never prefix with NEXT_PUBLIC_. Also signs booking-photo upload tokens.
SUPABASE_SECRET_KEY=
# Legacy fallback for the secret key (service_role JWT). Leave empty if the secret key is set.
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Feature gates (fail closed: unset = disabled)
# -----------------------------------------------------------------------------
# "true" enables public booking submissions and photo uploads.
BOOKING_SUBMISSIONS_ENABLED=false
# "true" / "1" / "yes" enables the newsletter-interest form.
NEWSLETTER_INTEREST_ENABLED=false
# Approved privacy-notice version stored with each booking, e.g. 2026-10-01 (1–60 chars of A-Z a-z 0-9 . _ -). Unset = stored as null.
BOOKING_PRIVACY_NOTICE_VERSION=

# -----------------------------------------------------------------------------
# Rate-limit modes (optional; leave unset in production = database-backed)
# -----------------------------------------------------------------------------
# "database" or "memory". Note: "memory" is honoured even in production for bookings.
BOOKING_RATE_LIMIT_MODE=
# "database" or "memory" ("memory" ignored when NODE_ENV=production).
NEWSLETTER_RATE_LIMIT_MODE=
# "database" or "memory" ("memory" ignored when NODE_ENV=production).
REVIEW_RATE_LIMIT_MODE=

# -----------------------------------------------------------------------------
# Transactional email — Brevo  (Brevo → SMTP & API, Brevo → Templates)
# Sender name/email, subject and preview text are set on each saved Brevo template, not here.
# -----------------------------------------------------------------------------
# Master switch. Anything but "true" = no email is sent. Keep false locally unless deliberately testing.
TRANSACTIONAL_EMAILS_ENABLED=false
# Brevo API key (xkeysib-...). Server-only.
BREVO_API_KEY=
# Random secret, >= 32 chars. REQUIRED for sending; also Bearer token for /api/internal/email/worker.
EMAIL_WORKER_SECRET=
# Random secret, >= 32 chars. Vercel Cron sends it as Bearer to /api/internal/email/worker.
CRON_SECRET=
# Random secret, >= 32 chars. Bearer token Brevo must send to /api/webhooks/brevo.
BREVO_WEBHOOK_SECRET=
# Inbox for the admin "send test" button (Email Delivery page).
EMAIL_TEST_RECIPIENT=

# Customer templates — all six REQUIRED (positive, unique integers) or no email is sent at all.
BREVO_TEMPLATE_BOOKING_RECEIVED_ID=
BREVO_TEMPLATE_BOOKING_CONFIRMED_ID=
BREVO_TEMPLATE_PROCESSING_STARTED_ID=
BREVO_TEMPLATE_LAUNDRY_READY_ID=
BREVO_TEMPLATE_BOOKING_COMPLETED_ID=
BREVO_TEMPLATE_BOOKING_CANCELLED_ID=

# Staff order alerts — all-or-nothing group: one missing ID disables all five staff alerts.
BREVO_TEMPLATE_STAFF_ORDER_PENDING_ID=
BREVO_TEMPLATE_STAFF_ORDER_PROCESSING_ID=
BREVO_TEMPLATE_STAFF_ORDER_READY_ID=
BREVO_TEMPLATE_STAFF_ORDER_COMPLETED_ID=
BREVO_TEMPLATE_STAFF_ORDER_CANCELLED_ID=

# Internal manager alert for newsletter interest sign-ups.
BREVO_TEMPLATE_NEWSLETTER_INTEREST_ID=
# Internal staff alert for public enquiries / commercial quotes.
BREVO_TEMPLATE_ENQUIRY_RECEIVED_ID=

# -----------------------------------------------------------------------------
# Scripts only (not read by the app)
# -----------------------------------------------------------------------------
# Auth user id recorded as the actor by: node scripts/cleanup-stuck-staff-invites.mjs --apply
# STAFF_CLEANUP_ACTOR_ID=

# -----------------------------------------------------------------------------
# Set automatically by the platform — do not define:
#   VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, NODE_ENV
#
# Removed (no longer read by code — see src/lib/reviews/config.ts):
#   REVIEW_SUBMISSIONS_ENABLED, REVIEW_NOTICE_VERSION
# Not read by code (Brevo template sender is used instead):
#   BREVO_SENDER_EMAIL, BREVO_SENDER_NAME
# =============================================================================
