[TEMPLATE]
# Copy to .env.local (never commit that file). No secret value belongs here:
# every variable below is either a public browser value or an origin.

# Frontend preview only. Keeps the isolated demo workspace and in-memory mock
# data available. Demo access never grants real administrator access, and it is
# inert when this is set to false. Production must set NEXT_PUBLIC_DEMO_MODE=false
# so the sessionStorage demo flag can no longer open the administration shell.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project — PUBLIC project values only.
# Supabase Dashboard → Project Settings → API. Never put a service-role or
# secret key in a NEXT_PUBLIC_ variable or in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may supply the legacy anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: verified production origin used to build Supabase Auth redirect
# links (password recovery, and administrator invitations since Sprint 1C).
# Leave unset until the production domain is cut over and its origin is added to
# the Supabase Auth redirect allow-list. Local development and Vercel preview
# hosts are already accepted without it.
# SITE_URL=https://your-verified-domain

# ---------------------------------------------------------------------------
# PUBLIC BOOKING SUBMISSIONS (Sprint 2B) — server-only
# ---------------------------------------------------------------------------
# Public submission is OFF unless this is explicitly set to true, so a deployment
# cannot expose the privileged submission path by accident. Even when enabled the
# endpoint still requires Supabase (URL + elevated key), a readable active
# catalogue and a shared rate limiter; it fails closed otherwise.
#   BOOKING_SUBMISSIONS_ENABLED=true

# Rate limiting for public submissions. Unset means: shared database limiter in
# production, in-process limiter in demo mode. Only set these for local work.
#   BOOKING_RATE_LIMIT_MODE=database   # shared production limiter (default)
#   BOOKING_RATE_LIMIT_MODE=memory     # local development and tests only

# ---------------------------------------------------------------------------
# PUBLIC REVIEWS (Sprint 3A) — server-only
# ---------------------------------------------------------------------------
# Reviews remain demo-only unless this is explicitly enabled. Production still
# fails closed unless Supabase + the elevated server key and a valid approved
# consent/notice version are configured. The browser cannot supply the version.
#   REVIEW_SUBMISSIONS_ENABLED=true
#   REVIEW_NOTICE_VERSION=<owner-approved-version>
# Optional local limiter override; production always uses the shared DB limiter.
#   REVIEW_RATE_LIMIT_MODE=memory
#   REVIEW_RATE_LIMIT_MODE=database

# ---------------------------------------------------------------------------
# PRIVACY-NOTICE VERSION (Sprint 2D.1) — server-only
# ---------------------------------------------------------------------------
# The SRS requires the server-approved privacy-notice version to be stored with
# each public booking. The browser cannot supply it; only this server value is
# written. Set it to the approved version identifier of the published Privacy
# Policy (1–60 letters, digits, dot, underscore or hyphen), for example:
#   BOOKING_PRIVACY_NOTICE_VERSION=2026-10-01
# Leave it unset until the owner approves a version: no value is invented, and
# the booking records no version. This is transactional-service provenance only —
# it is NOT marketing consent and never subscribes a customer to a newsletter.

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Sprint 2D.2) — server-only
# ---------------------------------------------------------------------------
# Sending is OFF unless this is explicitly true. The manual admin composer only
# needs this switch and a valid API key. Automated booking notifications also
# require all six template IDs, verified template senders, SITE_URL (above) and
# the worker secret. The webhook secret is needed only for delivery-event webhooks.
# Never place any of these in a NEXT_PUBLIC_* variable.
#
#   TRANSACTIONAL_EMAILS_ENABLED=false
#   BREVO_API_KEY=                 # Brevo API key (xkeysib-...); server-only
#   BREVO_TEMPLATE_BOOKING_RECEIVED_ID=       # Numeric saved-template ID from this Brevo account
#   BREVO_TEMPLATE_BOOKING_CONFIRMED_ID=      # Numeric saved-template ID from this Brevo account
#   BREVO_TEMPLATE_PROCESSING_STARTED_ID=     # Numeric saved-template ID from this Brevo account
#   BREVO_TEMPLATE_LAUNDRY_READY_ID=          # Numeric saved-template ID from this Brevo account
#   BREVO_TEMPLATE_BOOKING_COMPLETED_ID=      # Numeric saved-template ID from this Brevo account
#   BREVO_TEMPLATE_BOOKING_CANCELLED_ID=      # Numeric saved-template ID from this Brevo account
#   EMAIL_WORKER_SECRET=           # random >=32 chars; bearer secret for the worker endpoint
#   BREVO_WEBHOOK_SECRET=          # random >=32 chars; bearer token configured on the Brevo webhook
#
# All six customer IDs are required. Get them from the actual Brevo account; do not
# guess or copy IDs from another account. Saved templates must use the exact
# `params.*` contract documented in SPRINT_2D_EMAIL_IMPLEMENTATION.md. Configure
# each template's sender and reply-to in Brevo; the API request does not override
# those headers.
# The admin Compose Email page gets active verified sender options directly from
# the Brevo account; it does not require these six template IDs.
#
# Staff/admin order alerts (Phase 2E.1) reuse the same outbox and worker. These
# five IDs are read separately: leaving them unset does NOT disable customer
# email, it only leaves staff alert rows retryable until the saved templates are
# configured. Recipients come from public.booking_alert_recipients (Sprint 2E.2
# manages the list); an empty list queues nothing.
#   BREVO_TEMPLATE_STAFF_ORDER_PENDING_ID=      # Staff alert: order pending
#   BREVO_TEMPLATE_STAFF_ORDER_PROCESSING_ID=   # Staff alert: processing started
#   BREVO_TEMPLATE_STAFF_ORDER_READY_ID=        # Staff alert: order ready
#   BREVO_TEMPLATE_STAFF_ORDER_COMPLETED_ID=    # Staff alert: order completed
#   BREVO_TEMPLATE_STAFF_ORDER_CANCELLED_ID=    # Staff alert: order cancelled
# The staff `params.*` contract is documented in
# docs/implementation/SPRINT_2E1_STAFF_ORDER_ALERTS.md.
#
# This REST API uses a Brevo API key, not an SMTP key.
#
# The worker endpoint is /api/internal/email/worker. It is not scheduled by this
# repository; see docs/implementation/SPRINT_2D_EMAIL_IMPLEMENTATION.md for the exact
# hosting/scheduler steps. Leaving TRANSACTIONAL_EMAILS_ENABLED unset keeps all
# queued rows pending and sends nothing.

# ---------------------------------------------------------------------------
# SERVER-ONLY privileged credential (Sprint 1C)
# ---------------------------------------------------------------------------
# Staff invitations use the Supabase Auth Admin API, which requires an elevated
# key. It is read only by src/lib/supabase/admin.ts, is never placed in a
# NEXT_PUBLIC_ variable, and is never sent to the browser. Set it in the hosting
# provider's environment for the server only — NOT in this template file, and
# never in a NEXT_PUBLIC_* name.
#   SUPABASE_SECRET_KEY=            # Supabase Dashboard → Project Settings → API keys (secret key)
#   SUPABASE_SERVICE_ROLE_KEY=      # legacy Service Role key, still accepted
# Without it, the Staff Management page works for listing, role changes,
# suspension and restoration, but sending an invitation fails closed with a
# "not configured" message.
